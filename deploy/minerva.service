# systemd unit: serves Minerva over HTTPS on 443 and starts on boot.
# Install: sudo cp deploy/minerva.service /etc/systemd/system/ && sudo systemctl enable --now minerva
# TLS cert/key live outside the repo in ~/.minerva/tls (never commit them).
[Unit]
Description=Minerva FastAPI app
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/work/Minerva
ExecStart=/home/ec2-user/work/Minerva/.venv/bin/uvicorn minerva.main:app \
    --host 0.0.0.0 --port 443 \
    --ssl-certfile /home/ec2-user/.minerva/tls/cert.pem \
    --ssl-keyfile /home/ec2-user/.minerva/tls/key.pem
# Lets a non-root user bind port 443.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
