# 평일 08:00~18:59(KST) 30초마다, 그리고 기동 2분 뒤 한 번. 장 마감 뒤 체결까지 담는다.
# 한 번에 조회 2건(+토큰)이라 초당 한도에 걸리지 않는다.
[Unit]
Description=Refresh Minerva account snapshot every 30 seconds on weekdays

[Timer]
OnCalendar=Mon..Fri *-*-* 08..18:*:00/30 Asia/Seoul
AccuracySec=1s
OnBootSec=2min

[Install]
WantedBy=timers.target
