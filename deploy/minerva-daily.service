# 매일 일일 분석을 돌린다. 국내 매매 중지 동안 텔레그램 요약은 끈다(사용자 결정 2026-11-08, 다시 켜려면 --notify). minerva-daily.timer가 실행한다.
# 설치: sudo cp deploy/minerva-daily.* /etc/systemd/system/ && sudo systemctl enable --now minerva-daily.timer
[Unit]
Description=Minerva daily strategy analysis
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/work/Minerva
ExecStart=/home/ec2-user/work/Minerva/.venv/bin/python -m minerva.strategy.daily
