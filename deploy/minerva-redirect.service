# systemd unit: http://(포트 80) → https://minerva-ai.duckdns.org 301 리다이렉트.
# Install: sudo cp deploy/minerva-redirect.service /etc/systemd/system/ && sudo systemctl enable --now minerva-redirect
# certbot standalone 갱신과 포트가 겹치므로 pre/post 훅도 설치한다 (deploy/certbot-pre-hook.sh, certbot-post-hook.sh).
[Unit]
Description=Minerva HTTP to HTTPS redirect
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/work/Minerva
ExecStart=/usr/bin/python3 -I scripts/http_redirect.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
